# Telegram Bot Configuration
# Get your token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Telegram user IDs (comma-separated if multiple)
ADMIN_TG_IDS=123456789,987654321

# WebApp URL (where your Telegram Mini App frontend is accessible)
# For local development with Docker: http://localhost:3000
# For Telegram production or mobile testing: https://your-domain-or-tunnel.trycloudflare.com
WEBAPP_URL=http://localhost:3000

# Community Settings
PAYPAL_ME_URL=https://paypal.me/officecoffee
MONTHLY_TARGET=150.00

# Environment: development (allows test headers / mock dev auth) or production
ENVIRONMENT=development

# Database path (inside Docker container, mapped to host ./data)
DATABASE_URL=sqlite+aiosqlite:///data/coffee.db
