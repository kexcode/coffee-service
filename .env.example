# Telegram Bot Configuration (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Admin Usernames (without @, comma-separated) or numeric Telegram IDs
ADMIN_USERNAMES=your_telegram_username
ADMIN_TG_IDS=

# WebApp URL (where your Telegram Mini App frontend is accessible over HTTPS)
# Examples:
# - With Cloudflare Named Tunnel: https://coffee.yourdomain.com
# - With Caddy & Domain: https://coffee.yourdomain.com
# - With Quick Tunnel: https://<random>.trycloudflare.com
WEBAPP_URL=https://coffee.yourdomain.com

# Community Settings
PAYPAL_ME_URL=https://paypal.me/Rapatskiy
MONTHLY_TARGET=150.00

# Environment: production or development
ENVIRONMENT=production

# Database path (inside Docker container, mapped to host ./data)
DATABASE_URL=sqlite+aiosqlite:///app/data/coffee.db

# --- Optional Production HTTPS Routing ---

# If using Cloudflare Named Tunnel (recommended: zero firewall ports needed):
# Get token from Cloudflare Zero Trust -> Networks -> Tunnels
TUNNEL_TOKEN=

# If using Caddy with direct domain mapping (points DNS A-record to VM IP):
# DOMAIN=coffee.yourdomain.com
# ACME_EMAIL=your-email@example.com
